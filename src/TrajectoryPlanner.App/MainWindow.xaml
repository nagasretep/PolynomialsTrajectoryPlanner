<Window x:Class="TrajectoryPlanner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TrajectoryPlanner.App"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        Title="Polynomial Trajectory Planner - UI First Prototype"
        Icon="Assets/calculus.png"
        Height="1000"
        Width="1800"
        MinHeight="850"
        MinWidth="1400">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <!-- One vector quantity of the 3D mode: three boxes X | Y | Z. -->
        <DataTemplate x:Key="VectorBoxes" DataType="{x:Type local:VectorInput}">
            <UniformGrid Columns="3">
                <TextBox Margin="0,0,4,4" Text="{Binding X, UpdateSourceTrigger=PropertyChanged}" ToolTip="X" />
                <TextBox Margin="0,0,4,4" Text="{Binding Y, UpdateSourceTrigger=PropertyChanged}" ToolTip="Y" />
                <TextBox Margin="0,0,0,4" Text="{Binding Z, UpdateSourceTrigger=PropertyChanged}" ToolTip="Z" />
            </UniformGrid>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="520" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,12" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Border Margin="0,0,16,0" Padding="8,4" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0,0,10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="Mode" />
                        <RadioButton Margin="0,0,12,0" VerticalAlignment="Center" GroupName="Mode"
                                     IsChecked="{Binding IsBlendingMode}" Content="Blending" />
                        <RadioButton Margin="0,0,12,0" VerticalAlignment="Center" GroupName="Mode"
                                     IsChecked="{Binding IsPassThroughMode}" Content="Pass-through" />
                        <RadioButton Margin="0,0,12,0" VerticalAlignment="Center" GroupName="Mode"
                                     IsChecked="{Binding IsThreeDMode}" Content="3D" />
                        <RadioButton VerticalAlignment="Center" GroupName="Mode"
                                     IsChecked="{Binding IsThreeDPassThroughMode}" Content="3D pass-through" />
                    </StackPanel>
                </Border>
                <Button Width="130"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        Click="AddSegment_Click"
                        Visibility="{Binding IsSegmentMode, Converter={StaticResource BoolToVisibilityConverter}}"
                        Content="Add Segment" />
                <Button Width="130"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        Click="RemoveSelectedSegment_Click"
                        IsEnabled="{Binding CanRemoveSegment}"
                        Visibility="{Binding IsSegmentMode, Converter={StaticResource BoolToVisibilityConverter}}"
                        Content="Remove Segment" />
                <Button Width="130"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        Click="AddWaypoint_Click"
                        Visibility="{Binding IsWaypointMode, Converter={StaticResource BoolToVisibilityConverter}}"
                        Content="Add Waypoint" />
                <Button Width="130"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        Click="RemoveWaypoint_Click"
                        IsEnabled="{Binding CanRemoveWaypoint}"
                        Visibility="{Binding IsWaypointMode, Converter={StaticResource BoolToVisibilityConverter}}"
                        Content="Remove Waypoint" />
                <Button Width="130"
                        Margin="0,0,16,0"
                        Padding="10,6"
                        Click="Compute_Click"
                        Content="Compute" />
                <Button Width="70"
                        Margin="0,0,8,0"
                        Padding="10,6"
                        Click="OpenProject_Click"
                        ToolTip="Open a project file (the inputs of all four modes)"
                        Content="Open" />
                <Button Width="70"
                        Padding="10,6"
                        Click="SaveProject_Click"
                        ToolTip="Save the inputs of all four modes to a project file"
                        Content="Save" />
            </StackPanel>

            <TextBlock Margin="16,0,0,0"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"
                       Text="{Binding StatusMessage}" />
        </DockPanel>

        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,0,10"
                    DataContext="{Binding PassThroughInput}"
                    Visibility="{Binding DataContext.IsPassThroughMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Margin="0,0,0,8" Header="Pass-Through Setup">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Degree" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                          ItemsSource="{Binding DataContext.SupportedDegrees, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Degree}" />

                                <TextBlock Grid.Row="1" Margin="0,0,8,8" VerticalAlignment="Center" Text="Smoothness order m" />
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,8"
                                          ItemsSource="{Binding AvailableSmoothnessOrders}"
                                          SelectedItem="{Binding SmoothnessOrder}" />

                                <TextBlock Grid.Row="2" Grid.Column="1" FontStyle="Italic" TextWrapping="Wrap"
                                           Text="m = 1 velocity ... 4 snap. Default: snap for degree 9, otherwise m = (degree + 1) / 2." />
                            </Grid>
                        </GroupBox>

                        <GroupBox Margin="0,0,0,8" Header="End Conditions">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,8,6" FontWeight="SemiBold" Text="First waypoint" />
                                <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,0,6" FontWeight="SemiBold" Text="Last waypoint" />

                                <TextBlock Grid.Row="1" Margin="0,0,8,6" VerticalAlignment="Center" Text="At rest" />
                                <CheckBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,6" IsChecked="{Binding StartAtRest}" Content="v = a = j = s = 0" />
                                <CheckBox Grid.Row="1" Grid.Column="2" Margin="0,0,0,6" IsChecked="{Binding EndAtRest}" Content="v = a = j = s = 0" />

                                <TextBlock Grid.Row="2" Margin="0,0,8,6" VerticalAlignment="Center" Text="Velocity" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,8,6" IsEnabled="{Binding StartEditable}" Text="{Binding StartVelocity, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox Grid.Row="2" Grid.Column="2" Margin="0,0,0,6" IsEnabled="{Binding EndEditable}" Text="{Binding EndVelocity, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="3" Margin="0,0,8,6" VerticalAlignment="Center" Text="Acceleration"
                                           Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,8,6" IsEnabled="{Binding StartEditable}" Text="{Binding StartAcceleration, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBox Grid.Row="3" Grid.Column="2" Margin="0,0,0,6" IsEnabled="{Binding EndEditable}" Text="{Binding EndAcceleration, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <StackPanel Grid.Row="4" Grid.ColumnSpan="3">
                                    <Grid Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,8,6" VerticalAlignment="Center" Text="Jerk" />
                                        <TextBox Grid.Column="1" Margin="0,0,8,6" IsEnabled="{Binding StartEditable}" Text="{Binding StartJerk, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" Margin="0,0,0,6" IsEnabled="{Binding EndEditable}" Text="{Binding EndJerk, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                    <Grid Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Snap" />
                                        <TextBox Grid.Column="1" Margin="0,0,8,0" IsEnabled="{Binding StartEditable}" Text="{Binding StartSnap, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBox Grid.Column="2" IsEnabled="{Binding EndEditable}" Text="{Binding EndSnap, UpdateSourceTrigger=PropertyChanged}" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Margin="0,0,0,8" Header="Waypoints">
                            <StackPanel Margin="10">
                                <TextBlock Margin="0,0,0,6" FontStyle="Italic" TextWrapping="Wrap"
                                           Text="Duration = time of the segment that starts at that waypoint. Fill all durations or leave all blank (the last row has no duration)." />
                                <DataGrid x:Name="WaypointGrid"
                                          Height="170"
                                          ItemsSource="{Binding Waypoints}"
                                          SelectedItem="{Binding DataContext.SelectedWaypoint, RelativeSource={RelativeSource AncestorType=Window}}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Number}" Header="#" Width="40" IsReadOnly="True" />
                                        <DataGridTextColumn Binding="{Binding Position, UpdateSourceTrigger=PropertyChanged}" Header="Position" Width="*" />
                                        <DataGridTextColumn Binding="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Header="Duration [s]" Width="*">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSegment}" Value="False">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="Background" Value="#EEEEEE" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="Total duration [s]" />
                                    <TextBox Grid.Column="1" Text="{Binding TotalDuration, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBlock Margin="0,4,0,0" FontStyle="Italic" TextWrapping="Wrap"
                                           Text="Optional; not together with segment durations. Blank durations and no total: 1 s per segment, or the shortest feasible sequence if limits are set." />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Margin="0,0,0,8" Header="Limits (optional, whole trajectory)">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Margin="0,0,8,6" IsChecked="{Binding UseMaxVelocity}" Content="Maximum Velocity" />
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Text="{Binding MaxVelocity, UpdateSourceTrigger=PropertyChanged}" />

                                <CheckBox Grid.Row="1" Margin="0,0,8,6" IsChecked="{Binding UseMaxAcceleration}" Content="Maximum Acceleration"
                                          Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Text="{Binding MaxAcceleration, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <CheckBox Grid.Row="2" Margin="0,0,8,6" IsChecked="{Binding UseMaxJerk}" Content="Maximum Jerk"
                                          Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Text="{Binding MaxJerk, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <CheckBox Grid.Row="3" Margin="0,0,8,0" IsChecked="{Binding UseMaxSnap}" Content="Maximum Snap"
                                          Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaxSnap, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Row="0"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsBlendingMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <TabControl ItemsSource="{Binding Segments}"
                            SelectedItem="{Binding SelectedSegment}">
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:SegmentInputModel}">
                            <TextBlock Text="{Binding Header}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>

                    <TabControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type local:SegmentInputModel}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8">
                                    <GroupBox Margin="0,0,0,8" Header="Segment Setup">
                                        <Grid Margin="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Degree" />
                                            <ComboBox Grid.Row="0"
                                                      Grid.Column="1"
                                                      Margin="0,0,0,8"
                                                      ItemsSource="{Binding DataContext.SupportedDegrees, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Degree}" />

                                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,8" FontStyle="Italic" Text="Boundary conditions required by the selected degree" />

                                            <Grid Grid.Row="2" Grid.ColumnSpan="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="110" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,8,6" FontWeight="SemiBold" Text="Start" />
                                                <TextBlock Grid.Row="0" Grid.Column="2" Margin="0,0,0,6" FontWeight="SemiBold" Text="End" />

                                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Center" Text="Position" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,8,6" Text="{Binding StartPosition, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Grid.Row="1" Grid.Column="2" Margin="0,0,0,6" Text="{Binding EndPosition, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Center" Text="Velocity" />
                                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,8,6" Text="{Binding StartVelocity, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBox Grid.Row="2" Grid.Column="2" Margin="0,0,0,6" Text="{Binding EndVelocity, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Center" Text="Acceleration"
                                                           Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,8,6" Text="{Binding StartAcceleration, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBox Grid.Row="3" Grid.Column="2" Margin="0,0,0,6" Text="{Binding EndAcceleration, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <TextBlock Grid.Row="4" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Center" Text="Jerk"
                                                           Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,8,6" Text="{Binding StartJerk, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBox Grid.Row="4" Grid.Column="2" Margin="0,0,0,6" Text="{Binding EndJerk, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <TextBlock Grid.Row="5" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Snap"
                                                           Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,8,0" Text="{Binding StartSnap, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBox Grid.Row="5" Grid.Column="2" Margin="0,0,0,0" Text="{Binding EndSnap, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Grid>
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Margin="0,0,0,8" Header="Constraints">
                                        <Grid Margin="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <CheckBox Grid.Row="0" Grid.Column="0" Margin="0,0,8,6" IsChecked="{Binding UseDuration}" Content="Duration / Period" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" />

                                            <CheckBox Grid.Row="1" Grid.Column="0" Margin="0,0,8,6" IsChecked="{Binding UseMaxVelocity}" Content="Maximum Velocity" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Text="{Binding MaxVelocity, UpdateSourceTrigger=PropertyChanged}" />

                                            <CheckBox Grid.Row="2" Grid.Column="0" Margin="0,0,8,6" IsChecked="{Binding UseMaxAcceleration}" Content="Maximum Acceleration"
                                                      Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Text="{Binding MaxAcceleration, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <CheckBox Grid.Row="3" Grid.Column="0" Margin="0,0,8,6" IsChecked="{Binding UseMaxJerk}" Content="Maximum Jerk"
                                                      Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Text="{Binding MaxJerk, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <CheckBox Grid.Row="4" Grid.Column="0" Margin="0,0,8,0" IsChecked="{Binding UseMaxSnap}" Content="Maximum Snap"
                                                      Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,0" Text="{Binding MaxSnap, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Margin="0,0,0,8" Header="Optional Shape Controls">
                                        <StackPanel Margin="10">
                                            <TextBlock Margin="0,0,0,8"
                                                       FontStyle="Italic"
                                                       Text="Use constant velocity and blending only when needed; the chart on the right updates after Compute." />

                                            <Expander Margin="0,0,0,8" Header="Constant-Velocity Stretch">
                                                <StackPanel Margin="8,10,8,0">
                                                    <CheckBox Margin="0,0,0,8" IsChecked="{Binding UseConstantVelocity}" Content="Enable constant-velocity stretch" />
                                                    <Grid Visibility="{Binding UseConstantVelocity, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="150" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Center" Text="Stretch Start Value" />
                                                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ConstantVelocityStart, UpdateSourceTrigger=PropertyChanged}" />

                                                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Center" Text="Stretch End Value" />
                                                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ConstantVelocityEnd, UpdateSourceTrigger=PropertyChanged}" />

                                                        <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Constant Speed" />
                                                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,0" Text="{Binding ConstantVelocitySpeed, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Expander>

                                            <Expander Header="Blend Values"
                                                      Visibility="{Binding DataContext.HasMultipleSegments, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Margin="8,10,8,0">
                                                    <TextBlock Margin="0,0,0,8" FontStyle="Italic" Text="Leave empty to disable the connection on that side." />
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="160" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,8,6" VerticalAlignment="Center" Text="Initial Blend Value" />
                                                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Text="{Binding BlendToPrevious, UpdateSourceTrigger=PropertyChanged}" />

                                                        <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" Text="Final Blend Value" />
                                                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,0" Text="{Binding BlendToNext, UpdateSourceTrigger=PropertyChanged}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </GroupBox>

                                    <Border Padding="10"
                                            Background="#F7F7F7"
                                            CornerRadius="4">
                                        <TextBlock Text="Blending mode: 1D only, with blending and constant velocity. Exact pass-through is in the other mode (selector at the top)."
                                                   TextWrapping="Wrap" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Border>

            <Border Grid.Row="0"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,0,10"
                    Visibility="{Binding IsThreeDMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <TabControl ItemsSource="{Binding Segments3D}"
                            SelectedItem="{Binding SelectedSegment3D}">
                    <TabControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:Segment3DInputModel}">
                            <TextBlock Text="{Binding Header}" />
                        </DataTemplate>
                    </TabControl.ItemTemplate>

                    <TabControl.ContentTemplate>
                        <DataTemplate DataType="{x:Type local:Segment3DInputModel}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="8">
                                    <GroupBox Margin="0,0,0,8" Header="Segment Setup (vectors: X | Y | Z)">
                                        <Grid Margin="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Degree" />
                                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                                      ItemsSource="{Binding DataContext.SupportedDegrees, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      SelectedItem="{Binding Degree}" />

                                            <UniformGrid Grid.Row="1" Grid.Column="1" Columns="3" Margin="0,0,0,4">
                                                <TextBlock FontWeight="SemiBold" Text="X" />
                                                <TextBlock FontWeight="SemiBold" Text="Y" />
                                                <TextBlock FontWeight="SemiBold" Text="Z" />
                                            </UniformGrid>

                                            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Start position" />
                                            <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding StartPosition}" ContentTemplate="{StaticResource VectorBoxes}" />
                                            <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="End position" />
                                            <ContentControl Grid.Row="3" Grid.Column="1" Content="{Binding EndPosition}" ContentTemplate="{StaticResource VectorBoxes}" />

                                            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Start velocity" />
                                            <ContentControl Grid.Row="4" Grid.Column="1" Content="{Binding StartVelocity}" ContentTemplate="{StaticResource VectorBoxes}" />
                                            <TextBlock Grid.Row="5" VerticalAlignment="Center" Text="End velocity" />
                                            <ContentControl Grid.Row="5" Grid.Column="1" Content="{Binding EndVelocity}" ContentTemplate="{StaticResource VectorBoxes}" />

                                            <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="Start acceleration"
                                                       Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <ContentControl Grid.Row="6" Grid.Column="1" Content="{Binding StartAcceleration}" ContentTemplate="{StaticResource VectorBoxes}"
                                                            Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="End acceleration"
                                                       Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <ContentControl Grid.Row="7" Grid.Column="1" Content="{Binding EndAcceleration}" ContentTemplate="{StaticResource VectorBoxes}"
                                                            Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="Start jerk"
                                                       Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <ContentControl Grid.Row="8" Grid.Column="1" Content="{Binding StartJerk}" ContentTemplate="{StaticResource VectorBoxes}"
                                                            Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Grid.Row="9" VerticalAlignment="Center" Text="End jerk"
                                                       Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <ContentControl Grid.Row="9" Grid.Column="1" Content="{Binding EndJerk}" ContentTemplate="{StaticResource VectorBoxes}"
                                                            Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <TextBlock Grid.Row="10" VerticalAlignment="Center" Text="Start snap"
                                                       Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <ContentControl Grid.Row="10" Grid.Column="1" Content="{Binding StartSnap}" ContentTemplate="{StaticResource VectorBoxes}"
                                                            Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBlock Grid.Row="11" VerticalAlignment="Center" Text="End snap"
                                                       Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <ContentControl Grid.Row="11" Grid.Column="1" Content="{Binding EndSnap}" ContentTemplate="{StaticResource VectorBoxes}"
                                                            Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <TextBlock Grid.Row="12" Grid.Column="1" Margin="0,4,0,0" FontStyle="Italic" TextWrapping="Wrap"
                                                       Text="Positions are required; an empty box of a derivative row means zero." />
                                        </Grid>
                                    </GroupBox>

                                    <GroupBox Margin="0,0,0,8" Header="Constraints (limits apply to every axis)">
                                        <Grid Margin="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="200" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Margin="0,0,8,6" VerticalAlignment="Center" Text="Duration [s] (blank: automatic)" />
                                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" />

                                            <CheckBox Grid.Row="1" Margin="0,0,8,6" IsChecked="{Binding UseMaxVelocity}" Content="Maximum Velocity" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Text="{Binding MaxVelocity, UpdateSourceTrigger=PropertyChanged}" />

                                            <CheckBox Grid.Row="2" Margin="0,0,8,6" IsChecked="{Binding UseMaxAcceleration}" Content="Maximum Acceleration"
                                                      Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Text="{Binding MaxAcceleration, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <CheckBox Grid.Row="3" Margin="0,0,8,6" IsChecked="{Binding UseMaxJerk}" Content="Maximum Jerk"
                                                      Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,6" Text="{Binding MaxJerk, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />

                                            <CheckBox Grid.Row="4" Margin="0,0,8,0" IsChecked="{Binding UseMaxSnap}" Content="Maximum Snap"
                                                      Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding MaxSnap, UpdateSourceTrigger=PropertyChanged}"
                                                     Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </GroupBox>

                                    <Expander Margin="0,0,0,8" Header="Constant-Speed Stretch (curved or straight)">
                                        <StackPanel Margin="8,10,8,0">
                                            <CheckBox Margin="0,0,0,8" IsChecked="{Binding UseConstantSpeed}" Content="Enable the constant-speed stretch on this segment" />
                                            <Grid Visibility="{Binding UseConstantSpeed, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Margin="0,0,8,6" VerticalAlignment="Center" Text="Speed" />
                                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Text="{Binding Speed, UpdateSourceTrigger=PropertyChanged}" />

                                                <TextBlock Grid.Row="1" Margin="0,0,8,6" VerticalAlignment="Center" Text="Start and end given as" />
                                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" ItemsSource="{Binding StretchKinds}" SelectedItem="{Binding StretchKind}" />

                                                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Start point"
                                                           Visibility="{Binding StretchByPoints, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding StretchStartPoint}" ContentTemplate="{StaticResource VectorBoxes}"
                                                                Visibility="{Binding StretchByPoints, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="End point"
                                                           Visibility="{Binding StretchByPoints, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <ContentControl Grid.Row="3" Grid.Column="1" Content="{Binding StretchEndPoint}" ContentTemplate="{StaticResource VectorBoxes}"
                                                                Visibility="{Binding StretchByPoints, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <TextBlock Grid.Row="4" Margin="0,0,8,6" VerticalAlignment="Center" Text="Start fraction (0-1)"
                                                           Visibility="{Binding StretchByFractions, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBox Grid.Row="4" Grid.Column="1" Margin="0,0,0,6" Text="{Binding StretchStartFraction, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding StretchByFractions, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Grid.Row="5" Margin="0,0,8,6" VerticalAlignment="Center" Text="End fraction (0-1)"
                                                           Visibility="{Binding StretchByFractions, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBox Grid.Row="5" Grid.Column="1" Margin="0,0,0,6" Text="{Binding StretchEndFraction, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding StretchByFractions, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <TextBlock Grid.Row="6" Margin="0,0,8,6" VerticalAlignment="Center" Text="Entry duration [s]" />
                                                <TextBox Grid.Row="6" Grid.Column="1" Margin="0,0,0,6" Text="{Binding EntryDuration, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Row="7" Margin="0,0,8,6" VerticalAlignment="Center" Text="Exit duration [s]" />
                                                <TextBox Grid.Row="7" Grid.Column="1" Margin="0,0,0,6" Text="{Binding ExitDuration, UpdateSourceTrigger=PropertyChanged}" />
                                                <TextBlock Grid.Row="8" Margin="0,0,8,0" VerticalAlignment="Center" Text="Total duration [s]" />
                                                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding StretchTotalDuration, UpdateSourceTrigger=PropertyChanged}" />
                                            </Grid>
                                        </StackPanel>
                                    </Expander>

                                    <Expander Header="Blend Values"
                                              Visibility="{Binding DataContext.HasMultipleSegments3D, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Margin="8,10,8,0">
                                            <TextBlock Margin="0,0,0,8" FontStyle="Italic" TextWrapping="Wrap"
                                                       Text="Leave empty to disable the connection on that side. A fraction refers to this segment as entered. A segment with a constant-speed stretch cannot be blended." />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <TextBlock Grid.Row="0" Margin="0,0,8,6" VerticalAlignment="Center" Text="Values given as" />
                                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" ItemsSource="{Binding BlendKinds}" SelectedItem="{Binding BlendKind}" />

                                                <TextBlock Grid.Row="1" Margin="0,0,8,6" VerticalAlignment="Center" Text="Initial blend value"
                                                           Visibility="{Binding BlendByFractions, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Text="{Binding BlendToPrevious, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding BlendByFractions, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Grid.Row="2" Margin="0,0,8,6" VerticalAlignment="Center" Text="Final blend value"
                                                           Visibility="{Binding BlendByFractions, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Text="{Binding BlendToNext, UpdateSourceTrigger=PropertyChanged}"
                                                         Visibility="{Binding BlendByFractions, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Initial blend point"
                                                           Visibility="{Binding BlendByPoints, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <ContentControl Grid.Row="3" Grid.Column="1" Content="{Binding BlendToPreviousPoint}" ContentTemplate="{StaticResource VectorBoxes}"
                                                                Visibility="{Binding BlendByPoints, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Final blend point"
                                                           Visibility="{Binding BlendByPoints, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <ContentControl Grid.Row="4" Grid.Column="1" Content="{Binding BlendToNextPoint}" ContentTemplate="{StaticResource VectorBoxes}"
                                                                Visibility="{Binding BlendByPoints, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Grid>
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>
            </Border>

            <Border Grid.Row="0"
                    BorderBrush="#D0D0D0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="8"
                    Margin="0,0,0,10"
                    DataContext="{Binding PassThrough3DInput}"
                    Visibility="{Binding DataContext.IsThreeDPassThroughMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibilityConverter}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Margin="0,0,0,8" Header="3D Pass-Through Setup">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Margin="0,0,8,8" VerticalAlignment="Center" Text="Degree" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,8"
                                          ItemsSource="{Binding DataContext.SupportedDegrees, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding Degree}" />

                                <TextBlock Grid.Row="1" Margin="0,0,8,0" VerticalAlignment="Center" Text="Smoothness order m" />
                                <ComboBox Grid.Row="1" Grid.Column="1"
                                          ItemsSource="{Binding AvailableSmoothnessOrders}"
                                          SelectedItem="{Binding SmoothnessOrder}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Margin="0,0,0,8" Header="End Conditions (vectors: X | Y | Z, empty box = 0)">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Grid.ColumnSpan="2" Margin="0,0,0,6" IsChecked="{Binding StartAtRest}" Content="First waypoint at rest" />
                                <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Start velocity" />
                                <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding StartVelocity}" ContentTemplate="{StaticResource VectorBoxes}" IsEnabled="{Binding StartEditable}" />
                                <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="Start acceleration"
                                           Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ContentControl Grid.Row="2" Grid.Column="1" Content="{Binding StartAcceleration}" ContentTemplate="{StaticResource VectorBoxes}" IsEnabled="{Binding StartEditable}"
                                                Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Grid.Row="3" VerticalAlignment="Center" Text="Start jerk"
                                           Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ContentControl Grid.Row="3" Grid.Column="1" Content="{Binding StartJerk}" ContentTemplate="{StaticResource VectorBoxes}" IsEnabled="{Binding StartEditable}"
                                                Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="Start snap"
                                           Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ContentControl Grid.Row="4" Grid.Column="1" Content="{Binding StartSnap}" ContentTemplate="{StaticResource VectorBoxes}" IsEnabled="{Binding StartEditable}"
                                                Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />

                                <CheckBox Grid.Row="5" Grid.ColumnSpan="2" Margin="0,6,0,6" IsChecked="{Binding EndAtRest}" Content="Last waypoint at rest" />
                                <TextBlock Grid.Row="6" VerticalAlignment="Center" Text="End velocity" />
                                <ContentControl Grid.Row="6" Grid.Column="1" Content="{Binding EndVelocity}" ContentTemplate="{StaticResource VectorBoxes}" IsEnabled="{Binding EndEditable}" />
                                <TextBlock Grid.Row="7" VerticalAlignment="Center" Text="End acceleration"
                                           Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ContentControl Grid.Row="7" Grid.Column="1" Content="{Binding EndAcceleration}" ContentTemplate="{StaticResource VectorBoxes}" IsEnabled="{Binding EndEditable}"
                                                Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="End jerk"
                                           Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ContentControl Grid.Row="8" Grid.Column="1" Content="{Binding EndJerk}" ContentTemplate="{StaticResource VectorBoxes}" IsEnabled="{Binding EndEditable}"
                                                Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBlock Grid.Row="9" VerticalAlignment="Center" Text="End snap"
                                           Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ContentControl Grid.Row="9" Grid.Column="1" Content="{Binding EndSnap}" ContentTemplate="{StaticResource VectorBoxes}" IsEnabled="{Binding EndEditable}"
                                                Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Margin="0,0,0,8" Header="Waypoints">
                            <StackPanel Margin="10">
                                <TextBlock Margin="0,0,0,6" FontStyle="Italic" TextWrapping="Wrap"
                                           Text="Duration = time of the segment that starts at that waypoint (common to the three axes). Fill all durations or leave all blank (the last row has no duration)." />
                                <DataGrid x:Name="WaypointGrid3D"
                                          Height="170"
                                          ItemsSource="{Binding Waypoints}"
                                          SelectedItem="{Binding DataContext.SelectedWaypoint3D, RelativeSource={RelativeSource AncestorType=Window}}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Number}" Header="#" Width="35" IsReadOnly="True" />
                                        <DataGridTextColumn Binding="{Binding X, UpdateSourceTrigger=PropertyChanged}" Header="X" Width="*" />
                                        <DataGridTextColumn Binding="{Binding Y, UpdateSourceTrigger=PropertyChanged}" Header="Y" Width="*" />
                                        <DataGridTextColumn Binding="{Binding Z, UpdateSourceTrigger=PropertyChanged}" Header="Z" Width="*" />
                                        <DataGridTextColumn Binding="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Header="Duration [s]" Width="*">
                                            <DataGridTextColumn.CellStyle>
                                                <Style TargetType="DataGridCell">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSegment}" Value="False">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                            <Setter Property="Background" Value="#EEEEEE" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGridTextColumn.CellStyle>
                                        </DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock VerticalAlignment="Center" Text="Total duration [s]" />
                                    <TextBox Grid.Column="1" Text="{Binding TotalDuration, UpdateSourceTrigger=PropertyChanged}" />
                                </Grid>
                                <TextBlock Margin="0,4,0,0" FontStyle="Italic" TextWrapping="Wrap"
                                           Text="Optional; not together with segment durations. Blank durations and no total: the chord rule (one second per segment), or the shortest feasible common durations if limits are set." />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Margin="0,0,0,8" Header="Limits (optional, each value applies to every axis)">
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Margin="0,0,8,6" IsChecked="{Binding UseMaxVelocity}" Content="Maximum Velocity" />
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,6" Text="{Binding MaxVelocity, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox Grid.Row="1" Margin="0,0,8,6" IsChecked="{Binding UseMaxAcceleration}" Content="Maximum Acceleration"
                                          Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,6" Text="{Binding MaxAcceleration, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding SupportsAcceleration, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <CheckBox Grid.Row="2" Margin="0,0,8,6" IsChecked="{Binding UseMaxJerk}" Content="Maximum Jerk"
                                          Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,6" Text="{Binding MaxJerk, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding SupportsJerk, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <CheckBox Grid.Row="3" Margin="0,0,8,0" IsChecked="{Binding UseMaxSnap}" Content="Maximum Snap"
                                          Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding MaxSnap, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding SupportsSnap, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GroupBox Grid.Row="1" Header="Numeric Report">
                <TabControl x:Name="ReportTabs" Margin="8">
                    <TabItem Header="Extrema"
                             Visibility="{Binding IsOneDMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid ItemsSource="{Binding ExtremaReportRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Segment}" Header="Segment" Width="*" />
                                <DataGridTextColumn Binding="{Binding Quantity}" Header="Quantity" Width="100" />
                                <DataGridTextColumn Binding="{Binding Minimum, StringFormat=F6}" Header="Minimum" Width="110" />
                                <DataGridTextColumn Binding="{Binding Maximum, StringFormat=F6}" Header="Maximum" Width="110" />
                                <DataGridTextColumn Binding="{Binding MinTime, StringFormat=F6}" Header="t(min)" Width="95" />
                                <DataGridTextColumn Binding="{Binding MaxTime, StringFormat=F6}" Header="t(max)" Width="95" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Coefficients">
                        <DataGrid ItemsSource="{Binding CoefficientReportRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Segment}" Header="Segment" Width="*" />
                                <DataGridTextColumn Binding="{Binding Coefficient}" Header="Coefficient" Width="95" />
                                <DataGridTextColumn Binding="{Binding Value, StringFormat=F8}" Header="Value" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Summary"
                             Visibility="{Binding ShowsSummary, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DockPanel>
                            <GroupBox DockPanel.Dock="Bottom" Header="Peaks against the limits"
                                      Visibility="{Binding HasLimitPeaks, Converter={StaticResource BoolToVisibilityConverter}}">
                                <DataGrid ItemsSource="{Binding LimitPeakRows}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          MaxHeight="140">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Binding="{Binding Quantity}" Header="Quantity" Width="*" />
                                        <DataGridTextColumn Binding="{Binding Peak, StringFormat=F6}" Header="Peak" Width="90" />
                                        <DataGridTextColumn Binding="{Binding Limit, StringFormat=F6, TargetNullValue=''}" Header="Limit" Width="90" />
                                        <DataGridTextColumn Binding="{Binding PercentOfLimit, StringFormat=F4, TargetNullValue=''}" Header="% of limit" Width="80" />
                                        <DataGridTextColumn Binding="{Binding Segment}" Header="Segment" Width="65" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                            <DataGrid ItemsSource="{Binding SummaryReportRows}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Item}" Header="Item" Width="*" />
                                    <DataGridTextColumn Binding="{Binding Value}" Header="Value" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Waypoints"
                             Visibility="{Binding IsPassThroughMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid ItemsSource="{Binding WaypointStateRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Waypoint}" Header="#" Width="35" />
                                <DataGridTextColumn Binding="{Binding Time, StringFormat=F6}" Header="t" Width="*" />
                                <DataGridTextColumn Binding="{Binding Position, StringFormat=F6}" Header="x" Width="*" />
                                <DataGridTextColumn Binding="{Binding Velocity, StringFormat=F6}" Header="v" Width="*" />
                                <DataGridTextColumn Binding="{Binding Acceleration, StringFormat=F6}" Header="a" Width="*" />
                                <DataGridTextColumn Binding="{Binding Jerk, StringFormat=F6}" Header="j" Width="*" />
                                <DataGridTextColumn Binding="{Binding Snap, StringFormat=F6}" Header="s" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Parts"
                             Visibility="{Binding IsAny3DMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid ItemsSource="{Binding PartRows3D}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Part}" Header="Part" Width="80" />
                                <DataGridTextColumn Binding="{Binding Start, StringFormat=F4}" Header="Start" Width="60" />
                                <DataGridTextColumn Binding="{Binding Duration, StringFormat=F4}" Header="T [s]" Width="60" />
                                <DataGridTextColumn Binding="{Binding InheritedDuration, StringFormat=F4, TargetNullValue=''}" Header="Inherited" Width="64" />
                                <DataGridTextColumn Binding="{Binding Adjusted}" Header="Adjusted" Width="58" />
                                <DataGridTextColumn Binding="{Binding Length, StringFormat=F4, TargetNullValue=''}" Header="Length" Width="60" />
                                <DataGridTextColumn Binding="{Binding Speed, StringFormat=F4, TargetNullValue=''}" Header="Speed" Width="55" />
                                <DataGridTextColumn Binding="{Binding AdmissibleSpeed, StringFormat=F4, TargetNullValue=''}" Header="v adm" Width="55" />
                                <DataGridTextColumn Binding="{Binding BindingLimit}" Header="Binds" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Extrema 3D"
                             Visibility="{Binding IsAny3DMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid ItemsSource="{Binding ExtremaRows3D}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Quantity}" Header="Quantity" Width="*" />
                                <DataGridTextColumn Binding="{Binding Axis}" Header="Axis" Width="35" />
                                <DataGridTextColumn Binding="{Binding Minimum, StringFormat=F5}" Header="Min" Width="70" />
                                <DataGridTextColumn Binding="{Binding Maximum, StringFormat=F5}" Header="Max" Width="70" />
                                <DataGridTextColumn Binding="{Binding MaxAbsolute, StringFormat=F5}" Header="|max|" Width="70" />
                                <DataGridTextColumn Binding="{Binding MaxAbsoluteTime, StringFormat=F4}" Header="t(|max|)" Width="60" />
                                <DataGridTextColumn Binding="{Binding Part}" Header="Part" Width="75" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Peaks vs limits"
                             Visibility="{Binding IsAny3DMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid ItemsSource="{Binding LimitRows3D}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding LimitsOf}" Header="Limits of" Width="75" />
                                <DataGridTextColumn Binding="{Binding Quantity}" Header="Quantity" Width="*" />
                                <DataGridTextColumn Binding="{Binding Axis}" Header="Axis" Width="35" />
                                <DataGridTextColumn Binding="{Binding Peak, StringFormat=F5}" Header="Peak" Width="70" />
                                <DataGridTextColumn Binding="{Binding Limit, StringFormat=F4}" Header="Limit" Width="60" />
                                <DataGridTextColumn Binding="{Binding PercentOfLimit, StringFormat=F2}" Header="%" Width="55" />
                                <DataGridTextColumn Binding="{Binding Part}" Header="Part" Width="75" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem Header="Waypoint states"
                             Visibility="{Binding IsThreeDPassThroughMode, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid ItemsSource="{Binding WaypointStateRows3D}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Waypoint}" Header="#" Width="35" />
                                <DataGridTextColumn Binding="{Binding Time, StringFormat=F4}" Header="t" Width="60" />
                                <DataGridTextColumn Binding="{Binding Quantity}" Header="Quantity" Width="*" />
                                <DataGridTextColumn Binding="{Binding X, StringFormat=F6}" Header="X" Width="80" />
                                <DataGridTextColumn Binding="{Binding Y, StringFormat=F6}" Header="Y" Width="80" />
                                <DataGridTextColumn Binding="{Binding Z, StringFormat=F6}" Header="Z" Width="80" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                </TabControl>
            </GroupBox>
        </Grid>

        <GroupBox Grid.Row="1" Grid.Column="2" Header="Trajectory Visualization">
          <TabControl x:Name="ChartTabs" Margin="4">
            <TabItem Header="Time">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="PlotHost1"
                            Grid.Row="0"
                            Margin="0,0,0,8"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="4">
                        <ScottPlot:WpfPlot x:Name="TrajectoryPlot1" MouseMove="TrajectoryPlot_MouseMove" />
                    </Border>

                    <Border x:Name="PlotHost2"
                            Grid.Row="1"
                            Margin="0,0,0,8"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="4">
                        <ScottPlot:WpfPlot x:Name="TrajectoryPlot2" MouseMove="TrajectoryPlot_MouseMove" />
                    </Border>

                    <Border x:Name="PlotHost3"
                            Grid.Row="2"
                            Margin="0,0,0,8"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="4">
                        <ScottPlot:WpfPlot x:Name="TrajectoryPlot3" MouseMove="TrajectoryPlot_MouseMove" />
                    </Border>

                    <Border x:Name="PlotHost4"
                            Grid.Row="3"
                            Margin="0,0,0,8"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="4">
                        <ScottPlot:WpfPlot x:Name="TrajectoryPlot4" MouseMove="TrajectoryPlot_MouseMove" />
                    </Border>

                    <Border x:Name="PlotHost5"
                            Grid.Row="4"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="4">
                        <ScottPlot:WpfPlot x:Name="TrajectoryPlot5" MouseMove="TrajectoryPlot_MouseMove" />
                    </Border>
                </Grid>

                <DockPanel Grid.Column="1" Margin="12,0,0,0" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock FontWeight="SemiBold" Text="Cursor Readout" />
                        <TextBlock Margin="0,6,0,0" Text="{Binding CursorStatusText}" />
                        <TextBlock Margin="0,8,0,0"
                                   FontStyle="Italic"
                                   Text="Each quantity now uses its own vertical plot with independent scaling; hover any plot to inspect all values at the same time." />
                    </StackPanel>

                    <CheckBox DockPanel.Dock="Top" Margin="0,0,0,8" IsChecked="{Binding ShowNorm}" Content="Show the magnitude (norm) curves"
                              Visibility="{Binding IsAny3DMode, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Grid>
                        <DataGrid ItemsSource="{Binding CursorReadoutRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  Visibility="{Binding IsOneDMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Quantity}" Header="Quantity" Width="*" />
                                <DataGridTextColumn Binding="{Binding Value, StringFormat=F6}" Header="Value" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <DataGrid ItemsSource="{Binding Cursor3DRows}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True"
                                  Visibility="{Binding IsAny3DMode, Converter={StaticResource BoolToVisibilityConverter}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Quantity}" Header="Quantity" Width="*" />
                                <DataGridTextColumn Binding="{Binding X, StringFormat=F4}" Header="X" Width="58" />
                                <DataGridTextColumn Binding="{Binding Y, StringFormat=F4}" Header="Y" Width="58" />
                                <DataGridTextColumn Binding="{Binding Z, StringFormat=F4}" Header="Z" Width="58" />
                                <DataGridTextColumn Binding="{Binding Norm, StringFormat=F4}" Header="|.|" Width="58" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </DockPanel>
            </Grid>
            </TabItem>
            <TabItem Header="Path"
                     Visibility="{Binding IsAny3DMode, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Margin="0,0,0,6" FontStyle="Italic" TextWrapping="Wrap"
                               Text="Projections of the path (equal scales). Blue: segment, orange: blend, grey: entry / exit transition, red: constant-speed stretch. Black squares: segment start and end; the black dot follows the cursor of the Time tab." />
                    <UniformGrid Grid.Row="1" Columns="3">
                        <Border Margin="0,0,6,0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="4">
                            <ScottPlot:WpfPlot x:Name="PathPlotXY" />
                        </Border>
                        <Border Margin="0,0,6,0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="4">
                            <ScottPlot:WpfPlot x:Name="PathPlotXZ" />
                        </Border>
                        <Border BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="4">
                            <ScottPlot:WpfPlot x:Name="PathPlotYZ" />
                        </Border>
                    </UniformGrid>
                </Grid>
            </TabItem>
          </TabControl>
        </GroupBox>
    </Grid>
</Window>
