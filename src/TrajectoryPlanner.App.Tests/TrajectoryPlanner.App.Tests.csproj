<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The App is a WPF project (net8.0-windows); its service layer is a plain class, so it can be tested from here
         without opening a window. Core logic is tested in TrajectoryPlanner.Core.Tests. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TrajectoryPlanner.App\TrajectoryPlanner.App.csproj" />
    <ProjectReference Include="..\TrajectoryPlanner.Core\TrajectoryPlanner.Core.csproj" />
  </ItemGroup>

</Project>
